diff --git a/mk/android/app/jni/Android.mk b/mk/android/app/jni/Android.mk
index 2e33e71..88fbff9 100644
--- a/mk/android/app/jni/Android.mk
+++ b/mk/android/app/jni/Android.mk
@@ -87,8 +87,8 @@ LOCAL_CFLAGS += -DUSE_SDL2 -DANDROID -DPINGUS_NO_SOUND=1 -DPINGUS_USE_GLES=1
 LOCAL_CPPFLAGS += -DUSE_SDL2 -DANDROID -DPINGUS_NO_SOUND=1 -DPINGUS_USE_GLES=1 -std=c++23 -D_LIBCPP_ENABLE_EXPERIMENTAL=1
 endif
 
-# ndk-build skips sexpcpp's CMake checks; NDK 29's libc++ has float charconv
-SEXP_CHARCONV := -DSEXP_HAVE_FROM_CHARS_FLOAT=1 -DSEXP_HAVE_TO_CHARS_FLOAT=1
+# ndk-build skips sexpcpp's CMake checks; NDK 28 libc++ does not have float from_chars
+SEXP_CHARCONV :=
 LOCAL_CFLAGS += -DPRIO_USE_SEXPCPP=1 $(SEXP_CHARCONV) -DTINYGETTEXT_UTF8_ONLY=1
 LOCAL_CPPFLAGS += -DPRIO_USE_SEXPCPP=1 $(SEXP_CHARCONV) -DTINYGETTEXT_UTF8_ONLY=1
 ifndef PINGUS_VERSION
@@ -100,5 +100,6 @@ LOCAL_CFLAGS += -DPINGUS_DEFAULT_DATADIR=\"\" -DDATA_PREFIX=\"\"
 LOCAL_CPPFLAGS += -DPINGUS_DEFAULT_DATADIR=\"\" -DDATA_PREFIX=\"\"
 
 LOCAL_CPP_FEATURES := exceptions rtti
+LOCAL_LDFLAGS += -Wl,-z,max-page-size=16384
 
 include $(BUILD_SHARED_LIBRARY)
